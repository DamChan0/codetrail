#!/usr/bin/env python3
# Fake `pi --mode rpc`. Behaviour comes from ./scenario (cwd), one directive per line:
#   OUT:<raw line>   write to stdout after a prompt command
#   ERR:<text>       write to stderr
#   SLEEP:<secs>
#   EXIT:<code>      exit immediately (crash)
#   NOREPLY          do not answer the prompt command (hang)
#   IGNORE_TERM      ignore SIGTERM and stdin close (needs SIGKILL)
#   PIDFILE:<path>   write own pid
#   NOABORT          never answer (or react to) abort
#   REPEAT:<n>:<raw> write the raw stdout line n times
import json, os, signal, sys, time
sc = []
try:
    sc = open("scenario", encoding="utf-8").read().split("\n")
except OSError:
    pass
sc = [l for l in sc if l]
if "IGNORE_TERM" in sc:
    signal.signal(signal.SIGTERM, signal.SIG_IGN)
for l in sc:
    if l.startswith("PIDFILE:"):
        open(l[8:], "w").write(str(os.getpid()))
out = sys.stdout.buffer
def emit(raw):
    out.write(raw.encode("utf-8") + b"\n"); out.flush()
def respond(cmd, i, data=None, ok=True, err=None):
    r = {"id": i, "type": "response", "command": cmd, "success": ok}
    if data is not None: r["data"] = data
    if err: r["error"] = err
    emit(json.dumps(r))
def play():
    for l in sc:
        if l.startswith("OUT:"): emit(l[4:])
        elif l.startswith("ERR:"): sys.stderr.write(l[4:] + "\n"); sys.stderr.flush()
        elif l.startswith("REPEAT:"):
            n, raw = l[7:].split(":", 1)
            blob = (raw + "\n").encode("utf-8") * int(n)
            out.write(blob); out.flush()
        elif l.startswith("SLEEP:"): time.sleep(float(l[6:]))
        elif l.startswith("EXIT:"): os._exit(int(l[5:]))
# "interleaved stderr" noise at startup must never be parsed as protocol
sys.stderr.write('{"type":"response","id":"ct-1","success":false}\n'); sys.stderr.flush()
for raw in sys.stdin.buffer:
    try:
        cmd = json.loads(raw.decode("utf-8"))
    except Exception:
        emit(json.dumps({"type":"response","command":"parse","success":False,"error":"bad json"})); continue
    t, i = cmd.get("type"), cmd.get("id")
    if t == "prompt":
        if "NOREPLY" not in sc:
            respond(t, i)
        play()
    elif t == "get_available_models":
        respond(t, i, {"models": [{"id":"m1","name":"Model One","provider":"p","reasoning":True,"contextWindow":1000}]})
    elif t == "set_model" and cmd.get("modelId") == "bad":
        respond(t, i, ok=False, err="Model not found")
    elif t == "abort" and "NOABORT" in sc:
        pass
    elif t == "abort":
        respond(t, i) if i else None
        emit(json.dumps({"type":"agent_end","messages":[{"role":"assistant","stopReason":"aborted"}]}))
    else:
        respond(t, i, {})
if "IGNORE_TERM" in sc:
    while True: time.sleep(1)
